<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LightLag</RootNamespace>
    <AssemblyName>LightLag</AssemblyName>
    <LangVersion>8</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Release tags are v-prefixed (v0.1.0); MinVer ignores them without this. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- MinVer sets $(Version) / $(FileVersion) from git tags (v0.1.0 → 0.1.0) -->
    <PackageReference Include="MinVer" Version="4.*" PrivateAssets="All" />
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- CKANIdentifier drives `ckan install` in CI via setup-ckan + install-dependencies.
       Locally, the mods are expected in the KSP install (KSPBT_InstallCKANDependencies=false). -->
  <ItemGroup>
    <ModReference Include="0Harmony">
      <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
      <CKANIdentifier>Harmony2</CKANIdentifier>
    </ModReference>
  </ItemGroup>

  <!-- .version file generated on build. VERSION is filled by KSPBuildTools from $(FileVersion)
       after MinVer has run, so it's not set here. The destination is gitignored. -->
  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)LightLag.version</Destination>
      <URL>https://github.com/MinmusMachineWorks/LightLag/releases/latest/download/LightLag.version</URL>
      <Download>https://github.com/MinmusMachineWorks/LightLag/releases/latest</Download>
      <KSP_Version>1.12</KSP_Version>
      <KSP_Version_Min>1.12</KSP_Version_Min>
      <KSP_Version_Max>1.12</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>

</Project>
